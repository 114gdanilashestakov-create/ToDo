<Window x:Class="Desktop.MainTasks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачи" Height="700" Width="1200" WindowStartupLocation="CenterScreen" Foreground="#FFEDE5E5">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="60" Background="White" x:Name="LeftPanel">
            <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">
                <Button Content="+" Width="41" Height="40" Background="#FF007ACC" 
                       Foreground="White" BorderBrush="#FF007ACC" Margin="10,0,10,20"
                       FontSize="20" FontWeight="Bold" Click="AddTaskButton_Click"/>
                <Border Width="40" Height="40" CornerRadius="20" Background="#FF007ACC" 
                       Margin="10,20,10,10">
                    <TextBlock Text="A" Foreground="White" FontSize="16" FontWeight="Bold"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="UserNameTextBlock" Text="USER" Foreground="#FF050505" 
                          HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,20"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156*"/>
                <ColumnDefinition Width="29*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="60" Background="#FF007ACC" Grid.ColumnSpan="2" BorderBrush="#FF007ACC">
                <StackPanel x:Name="CategoriesPanel" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="20,0">
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="White" Grid.ColumnSpan="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
                    <StackPanel x:Name="TasksPanel" Margin="20">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Column="2" Background="White">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="60" Background="#FF007ACC" BorderBrush="#FF007ACC">
                    <TextBlock x:Name="SelectedTaskTitle" Text="Заголовок" 
                              Foreground="White" FontSize="16" FontWeight="Bold"
                              VerticalAlignment="Center" Margin="20,0"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#FFEDEDED">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="SelectedTaskDate" Text="18:00 01 Января 2022" 
                                  Foreground="#FF007ACC" FontSize="14" Margin="0,0,0,20"/>

                        <TextBlock x:Name="SelectedTaskDescription" 
                                  Text="Lorem ipsum dolor sit amet, consectetur adipiscing." 
                                  Foreground="Black" TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" Height="100" Background="#FFD2D2D2" HorizontalAlignment="Center" Width="400" VerticalAlignment="Bottom" RenderTransformOrigin="0.51,0.516">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                               VerticalAlignment="Center" Margin="20">
                        <Button x:Name="CompleteButton" Content="Готово" Width="100" Height="35" 
                               Background="#FFE84A4A" Foreground="White" 
                               BorderBrush="{x:Null}"
                               Click="CompleteButton_Click"/>
                        <Button x:Name="DeleteButton" Content="Удалить" Width="100" Height="35" 
                               Background="#FFE81123" Foreground="White" 
                               BorderBrush="{x:Null}" Click="DeleteButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>