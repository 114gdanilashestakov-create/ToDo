<Window x:Class="Desktop.MainTasks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачи" Height="700" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Background="#FF2D2D30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель (навигация) -->
        <Border Grid.Column="0" Width="60" Background="#FF252526" x:Name="LeftPanel">
            <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">
                <Button Content="+" Width="40" Height="40" Background="#FFF96060" 
                       Foreground="White" BorderBrush="#FF007ACC" Margin="10,0,10,20"
                       FontSize="20" FontWeight="Bold" Click="AddTaskButton_Click"/>

                <!-- Профиль пользователя -->
                <Border Width="40" Height="40" CornerRadius="20" Background="#FFF96060" 
                       Margin="10,20,10,10">
                    <TextBlock Text="A" Foreground="White" FontSize="16" FontWeight="Bold"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="UserNameTextBlock" Text="Alex" Foreground="White" 
                          HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,20"/>
            </StackPanel>
        </Border>

        <!-- Центральная панель (список задач) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Категории -->
            <Border Grid.Row="0" Height="60" Background="#FF252526">
                <StackPanel x:Name="CategoriesPanel" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="20,0">
                    <!-- Категории будут добавляться динамически -->
                </StackPanel>
            </Border>

            <!-- Список задач -->
            <Border Grid.Row="1" Background="#FF2D2D30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TasksPanel" Margin="20">
                        <!-- Задачи будут добавляться динамически -->
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Правая панель (детали задачи) -->
        <Border Grid.Column="2" Background="#FF252526">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок деталей -->
                <Border Grid.Row="0" Height="60" Background="#FFF96060">
                    <TextBlock x:Name="SelectedTaskTitle" Text="Заголовок" 
                              Foreground="White" FontSize="16" FontWeight="Bold"
                              VerticalAlignment="Center" Margin="20,0"/>
                </Border>

                <!-- Детали задачи -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="SelectedTaskDate" Text="18:00 01 Января 2022" 
                                  Foreground="#FF007ACC" FontSize="14" Margin="0,0,0,20"/>

                        <TextBlock x:Name="SelectedTaskDescription" 
                                  Text="Lorem ipsum dolor sit amet, consectetur adipiscing." 
                                  Foreground="White" TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- Кнопки действий -->
                <Border Grid.Row="2" Height="100" Background="#FF1E1E1E">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                               VerticalAlignment="Center" Margin="20">
                        <Button x:Name="CompleteButton" Content="Готово" Width="100" Height="35" 
                               Background="#FFF96060" Foreground="White" 
                               BorderBrush="#FFF96060" Margin="0,0,10,0"
                               Click="CompleteButton_Click"/>
                        <Button x:Name="DeleteButton" Content="Удалить" Width="100" Height="35" 
                               Background="#FFF96060" Foreground="White" 
                               BorderBrush="#FFF96060" Click="DeleteButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
