<Window x:Class="Desktop.CreateTask"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание задачи" Height="472" Width="516" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF007ACC" Height="40">
            <TextBlock Text="Создание задачи" Foreground="White" 
                      FontSize="16" FontWeight="Bold"
                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="1" Margin="20">
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Название" Foreground="Black" Margin="0,0,0,5"/>
                <TextBox x:Name="TitleTextBox" Height="30" Background="#FFB5AEAE" 
                        Foreground="Black" BorderBrush="#FFB5AEAE"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Категория" Foreground="Black" Margin="0,0,0,5"/>
                <ComboBox x:Name="CategoryComboBox" Height="30" Background="#FFB5AEAE" 
                         Foreground="Black" BorderBrush="#FFB5AEAE">
                    <ComboBoxItem Content="Дом" IsSelected="True"/>
                    <ComboBoxItem Content="Работа"/>
                    <ComboBoxItem Content="Учеба"/>
                    <ComboBoxItem Content="Отдых"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Описание" Foreground="Black" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox" Height="100" Background="#FFB5AEAE" 
                        Foreground="Black" BorderBrush="#FFB5AEAE" 
                        TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Дата и время" Foreground="White" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DatePicker x:Name="DatePickerControl" Grid.Column="0" Height="30" 
                               Background="#FFB5AEAE" Foreground="Black" 
                               BorderBrush="#FFB5AEAE" Margin="0,0,5,0"/>

                    <ComboBox x:Name="TimePickerControl" Grid.Column="1" Height="30" 
                             Background="#FFB5AEAE" Foreground="Black" 
                             BorderBrush="#FFB5AEAE" Margin="5,0,0,0">
                        <ComboBoxItem Content="9:00"/>
                        <ComboBoxItem Content="10:00"/>
                        <ComboBoxItem Content="11:00"/>
                        <ComboBoxItem Content="12:00"/>
                        <ComboBoxItem Content="13:00"/>
                        <ComboBoxItem Content="14:00"/>
                        <ComboBoxItem Content="15:00"/>
                        <ComboBoxItem Content="16:00"/>
                        <ComboBoxItem Content="17:00"/>
                        <ComboBoxItem Content="18:00"/>
                        <ComboBoxItem Content="19:00"/>
                        <ComboBoxItem Content="20:00"/>
                        <ComboBoxItem Content="21:00"/>
                        <ComboBoxItem Content="22:00"/>
                        <ComboBoxItem Content="23:00"/>
                        <ComboBoxItem Content="0:00"/>
                        <ComboBoxItem Content="1:00"/>
                        <ComboBoxItem Content="2:00"/>
                        <ComboBoxItem Content="3:00"/>
                        <ComboBoxItem Content="4:00"/>
                        <ComboBoxItem Content="5:00"/>
                        <ComboBoxItem Content="6:00"/>
                        <ComboBoxItem Content="7:00"/>
                        <ComboBoxItem Content="8:00"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="White" Height="77" HorizontalAlignment="Center" Margin="0,341,0,0" Width="516" VerticalAlignment="Top" Grid.RowSpan="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20">
                <Button x:Name="CreateButton" Content="Создать" Width="100" Height="35" 
                       Background="#FF50AF54" Foreground="White" 
                       BorderBrush="{x:Null}" Margin="0,0,10,0"
                       Click="CreateButton_Click"/>
                <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="35" 
                       Background="#FFE04321" Foreground="White" 
                       BorderBrush="{x:Null}" Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>